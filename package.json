{
  "name": "sudoku-dlx",
  "version": "2.0.0",
  "description": "Fast Sudoku solver using Dancing Links",
  "author": "Tim Beyer",
  "license": "MIT",
  "homepage": "https://github.com/TimBeyer/sudoku-dlx",
  "repository": {
    "type": "git",
    "url": "https://github.com/TimBeyer/sudoku-dlx.git"
  },
  "bugs": {
    "url": "https://github.com/TimBeyer/sudoku-dlx/issues"
  },
  "type": "module",
  "main": "./built/lib/index.js",
  "types": "./built/typings/index.d.ts",
  "exports": {
    ".": {
      "types": "./built/typings/index.d.ts",
      "import": "./built/lib/index.js"
    }
  },
  "bin": {
    "sudoku-solve": "./bin/sudoku-solve"
  },
  "files": [
    "built/lib",
    "built/typings",
    "bin",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.10.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "directories": {
    "test": "test"
  },
  "keywords": [
    "sudoku",
    "sudoku solver",
    "dlx",
    "dancing links",
    "algorithm x",
    "exact cover"
  ],
  "scripts": {
    "clean": "rimraf built",
    "build": "npm run clean && tsc",
    "build:dev": "npm run build && tsc -p tsconfig.dev.json",
    "build-dev": "npm run build:dev",
    "smoke:package": "node --import=tsx scripts/check-package.ts",
    "check:package": "npm run build && npm run smoke:package && npm run build:dev && npm run smoke:package",
    "prepare": "npm run build",
    "test": "npm run test:unit",
    "test:unit": "NODE_ENV=test mocha --import=tsx 'test/unit/**/*.spec.ts'",
    "test-unit": "npm run test:unit",
    "test:watch": "npm run test:unit -- --watch",
    "test-watch": "npm run test:watch",
    "test:bun": "bun test test/unit/index.spec.ts test/unit/benchmark.spec.ts test/unit/native-competition.spec.ts",
    "cover": "c8 --all --reporter=text --reporter=lcov npm run test:unit",
    "coverage": "npm run cover",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,js,json,md,yml,yaml}' '!CHANGELOG.md'",
    "format:check": "prettier --check '**/*.{ts,js,json,md,yml,yaml}' '!CHANGELOG.md'",
    "check": "npm run format:check && npm run lint && npm run test && npm run benchmark:corpus:verify && npm run check:package",
    "benchmark": "npm run build:dev && node built/dev/benchmark/index.js --internal",
    "benchmark:json": "npm run build:dev && node built/dev/benchmark/index.js --internal --json",
    "benchmark:competitive": "npm run build:dev && node built/dev/benchmark/index.js --competitive",
    "benchmark:wasm": "npm run build:dev && node built/dev/benchmark/index.js --wasm",
    "benchmark:legacy": "npm run build:dev && node built/dev/benchmark/index.js --legacy",
    "benchmark:comprehensive": "npm run build:dev && node built/dev/benchmark/index.js --comprehensive",
    "benchmark:native:install": "npm ci --prefix benchmark/native",
    "benchmark:native": "npm run build:dev && node built/dev/benchmark/index.js --native",
    "benchmark:competition:setup": "npm run build:dev && node built/dev/scripts/setup-native-competition.js",
    "benchmark:competition": "npm run build:dev && node built/dev/scripts/run-native-competition.js",
    "benchmark:corpus:verify": "node --import=tsx scripts/generate-representative-corpus.ts --verify",
    "compare-benchmarks": "npm run build:dev && node built/dev/scripts/compare-benchmarks.js",
    "update-benchmark-docs": "npm run build:dev && node built/dev/scripts/update-benchmark-docs.js",
    "update-benchmark-docs:dry-run": "npm run build:dev && node built/dev/scripts/update-benchmark-docs.js --dry-run",
    "profile": "npm run build:dev && node --cpu-prof --cpu-prof-name=profile.cpuprofile built/dev/benchmark/profile.js",
    "pack:check": "npm pack --dry-run",
    "release": "release-it"
  },
  "c8": {
    "all": true,
    "include": [
      "index.ts",
      "lib/**/*.ts"
    ],
    "exclude": [
      "test/**",
      "benchmark/**",
      "scripts/**",
      "node_modules/**"
    ],
    "excludeAfterRemap": true
  },
  "dependencies": {
    "dancing-links": "^4.3.10"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@algorithm.ts/sudoku": "4.0.4",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^10.0.1",
    "@hackettyam/sudoku-tools": "1.1.0",
    "@mattflow/sudoku-solver": "2.2.0",
    "@pyroth/sodo": "0.2.1",
    "@reetesh/sudoku-engine": "2.1.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "conventional-commits-filter": "^5.0.0",
    "conventional-commits-parser": "^6.4.0",
    "dancing-links-algorithm": "1.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-sudoku-solver": "3.0.3",
    "globals": "^17.7.0",
    "mocha": "^11.7.6",
    "openzeloku": "0.1.0",
    "prettier": "^3.9.5",
    "release-it": "^20.2.1",
    "rimraf": "^6.1.3",
    "sudoku_solver": "1.0.1",
    "sudoku-pro": "1.0.15",
    "sudoku-solver-js": "0.1.4",
    "sudokublitz": "1.0.0",
    "tinybench": "^6.0.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
