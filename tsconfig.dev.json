{
  "compilerOptions": {
    "outDir": "./built/lib",
    "allowJs": true,
    "target": "ES2020",
    "module": "ES2020",
    "lib": [
      "ES2020"
    ],
    "sourceMap": true,
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "./index.ts",
    "./src/**/*",
    "./benchmark/**/*"
  ]
}
